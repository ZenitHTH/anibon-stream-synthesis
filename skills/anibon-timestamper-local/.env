# ==============================================================================
# Anibon Timestamper Local - Environment Configuration
# ==============================================================================

# ── Endpoint & Model Resolution ──────────────────────────────────────────────
ANIBON_PRIMARY_HOST=100.115.25.30
ANIBON_PORT=1234
ANIBON_DEFAULT_MODEL=gemma-4-12b-it-qat@q4_k_xl
ANIBON_PROBE_TIMEOUT_SEC=1.0

# ── Token Budgets ─────────────────────────────────────────────────────────────
ANIBON_CHUNK_MAX_TOKENS=4096
ANIBON_PRUNE_MAX_TOKENS=4000
ANIBON_SUMMARIZER_MAX_TOKENS=4096
ANIBON_ENTITY_CONTEXT_MAX_TOKENS=300

# ── Timeouts (Seconds) ────────────────────────────────────────────────────────
ANIBON_CHUNK_TIMEOUT_SEC=180
ANIBON_MULTIMODAL_TIMEOUT_SEC=120
ANIBON_PRUNE_TIMEOUT_SEC=600
ANIBON_SUMMARIZER_TIMEOUT_SEC=600

# ── Temperatures & Retries ───────────────────────────────────────────────────
ANIBON_TEMPERATURE=0.1
ANIBON_VISION_TEMPERATURE=0.2
ANIBON_MAX_RETRIES=2

# ── Pruning Bounds & Thresholds ───────────────────────────────────────────────
ANIBON_PRUNE_MIN_INPUT=60
ANIBON_PRUNE_TARGET_MIN=40
ANIBON_PRUNE_TARGET_MAX=60

# ── Deduplication & Formatting ───────────────────────────────────────────────
ANIBON_DEDUP_MIN_GAP_SEC=120
ANIBON_DEDUP_MAX_GAP_SEC=600
ANIBON_STAMP_COLLISION_SEC=45
ANIBON_GROUP_SIZE=4
ANIBON_BLOCK_SIZE=2400
ANIBON_BYTE_CAP_LIMIT=3500
